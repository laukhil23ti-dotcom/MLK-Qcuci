<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/qcuci_bg">

    <!-- Header Card for Multi-Fragment Section -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/white"
        app:strokeColor="@color/qcuci_teal_light"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sub_frag_title"
                android:textColor="@color/qcuci_teal_primary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sub_frag_desc"
                android:textColor="@color/qcuci_text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <!-- 3 Dedicated Buttons to Switch Between 3 Sub-Fragments -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubKiloan"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/btn_sub_kiloan"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/qcuci_teal_primary"
                    app:cornerRadius="8dp"
                    android:layout_marginEnd="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubSatuan"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/btn_sub_satuan"
                    android:textColor="@color/qcuci_teal_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:strokeColor="@color/qcuci_teal_primary"
                    app:cornerRadius="8dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubTracking"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/btn_sub_tracking"
                    android:textColor="@color/qcuci_teal_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:strokeColor="@color/qcuci_teal_primary"
                    app:cornerRadius="8dp"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Sub Fragment Container View -->
    <FrameLayout
        android:id="@+id/sub_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>