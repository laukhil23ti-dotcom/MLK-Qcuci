<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp">

    <!-- Logo Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/white"
        app:strokeColor="@color/qcuci_teal_light"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/imgLogoHome"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:padding="16dp"
            android:src="@drawable/qcuci"
            android:contentDescription="@string/desc_logo"
            android:scaleType="fitCenter" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Welcome Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/white"
        app:strokeColor="@color/qcuci_teal_light"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_qcuci"
                android:textColor="@color/qcuci_teal_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline_qcuci"
                android:textColor="@color/qcuci_gold_dark"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="60dp"
                android:layout_height="3dp"
                android:background="@color/qcuci_gold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/desc_main"
                android:textColor="@color/qcuci_text_dark"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />

            <!-- Button 1: Detail Activity -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMyProject"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/btn_explore"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/qcuci_teal_primary"
                app:icon="@android:drawable/ic_menu_info_details"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/white"
                android:layout_marginBottom="12dp" />

            <!-- Button 2: Calculator Activity -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalculator"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/btn_calculator"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/qcuci_gold"
                app:icon="@android:drawable/ic_menu_manage"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/white"
                android:layout_marginBottom="12dp" />

            <!-- Button 3: Website Activity -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWebsite"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/btn_website"
                android:textColor="@color/qcuci_teal_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/qcuci_teal_light"
                app:strokeColor="@color/qcuci_teal_primary"
                app:strokeWidth="1.5dp"
                app:icon="@android:drawable/ic_menu_compass"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/qcuci_teal_primary" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/footer_qcuci"
        android:textColor="@color/qcuci_text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

</LinearLayout>