<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qcuci_bg">

    <!-- AppBarLayout with scroll flags for hide-on-scroll-down & show-on-scroll-up -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/qcuci_teal_primary">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarCalc"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/qcuci_teal_primary"
            app:title="@string/title_calculator"
            app:titleTextColor="@color/white"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/white"
            app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6"
            app:layout_scrollFlags="scroll|enterAlways" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- NestedScrollView linked to AppBarLayout scrolling behavior -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Form Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/qcuci_teal_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calc_choose_service"
                        android:textColor="@color/qcuci_teal_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <RadioGroup
                        android:id="@+id/rgServices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <RadioButton
                            android:id="@+id/rbReguler"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/service_reguler"
                            android:textColor="@color/qcuci_text_dark"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rbExpress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/service_express"
                            android:textColor="@color/qcuci_text_dark" />

                        <RadioButton
                            android:id="@+id/rbDryClean"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/service_dry_clean"
                            android:textColor="@color/qcuci_text_dark" />

                        <RadioButton
                            android:id="@+id/rbBedcover"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/service_bedcover"
                            android:textColor="@color/qcuci_text_dark" />

                    </RadioGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calc_input_weight"
                        android:textColor="@color/qcuci_teal_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/calc_weight_hint"
                        app:boxStrokeColor="@color/qcuci_teal_primary"
                        app:hintTextColor="@color/qcuci_teal_primary"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/qcuci_text_dark" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calc_addons"
                        android:textColor="@color/qcuci_teal_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <CheckBox
                        android:id="@+id/cbParfum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/addon_parfum"
                        android:textColor="@color/qcuci_text_dark" />

                    <CheckBox
                        android:id="@+id/cbSoftener"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/addon_softener"
                        android:textColor="@color/qcuci_text_dark" />

                    <CheckBox
                        android:id="@+id/cbAntiNoda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/addon_anti_noda"
                        android:textColor="@color/qcuci_text_dark"
                        android:layout_marginBottom="20dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCalculate"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="@string/calc_btn_calculate"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/qcuci_teal_primary"
                        app:icon="@android:drawable/ic_menu_manage"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@color/white" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Result Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/qcuci_teal_light"
                app:strokeColor="@color/qcuci_teal_primary"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calc_result_header"
                        android:textColor="@color/qcuci_teal_primary"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvResultService"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/qcuci_text_dark"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvResultAddons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/qcuci_text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/qcuci_teal_primary"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/calc_total_label"
                            android:textColor="@color/qcuci_text_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvResultTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/qcuci_gold_dark"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-black"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/footer_qcuci"
                android:textColor="@color/qcuci_text_secondary"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>